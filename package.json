{
  "name": "aielts-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=10.12.1 <11"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/run-database-test.mjs",
    "test:db:development": "node scripts/run-development-database-test.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.mjs",
    "db:migrate": "node scripts/run-migrations.mjs DATABASE_URL",
    "db:migrate:test": "node scripts/run-migrations.mjs TEST_DATABASE_URL",
    "build": "next build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@next/env": "^16.0.0",
    "drizzle-orm": "^0.45.0",
    "next": "^16.0.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  }
}
